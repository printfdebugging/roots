    {
      "id": "EO6hafe-WHiBTXmU_XlEL",
      "type": "text",
      "x": 2036.9035783835452,
      "y": 3168.979272147458,
      "width": 729.4920043945312,
      "height": 509.1488252088053,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4S",
      "roundness": null,
      "seed": 70919593,
      "version": 3088,
      "versionNonce": 1750463591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786714483634,
      "link": null,
      "locked": false,
      "text": "Iterate over the visible lines => lineNumber:\n    ask editor for line at lineNumber => lineUTF8;\n    layout lineUTF8 => lineGlyphQuads;\n\nlayout lineUTF8:\n    convert lineUTF8 to runes => lineRunes;\n    getMainFont => mainFont;\n    shape with harfbuzz\n    iterate over runes in lineRunes => rune;\n        check mainFont for cached GlyphInfo;\n            if notCached => cache & upload to glyphTexture (store offset)\n            if cached => nothingToDo\n        getGlyphInfo\n        calculateBoundingBox\n        store boundingBox and fontTexture info in the lineQuads object\n",
      "fontSize": 23.57170487077802,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "yINVZseQQNQW5qmWH8V9r",
      "originalText": "Iterate over the visible lines => lineNumber:\n    ask editor for line at lineNumber => lineUTF8;\n    layout lineUTF8 => lineGlyphQuads;\n\nlayout lineUTF8:\n    convert lineUTF8 to runes => lineRunes;\n    getMainFont => mainFont;\n    shape with harfbuzz\n    iterate over runes in lineRunes => rune;\n        check mainFont for cached GlyphInfo;\n            if notCached => cache & upload to glyphTexture (store offset)\n            if cached => nothingToDo\n        getGlyphInfo\n        calculateBoundingBox\n        store boundingBox and fontTexture info in the lineQuads object\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
