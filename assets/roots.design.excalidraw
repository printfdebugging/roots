      "boundElements": [],
      "updated": 1786714827692,
      "link": null,
      "locked": false,
      "text": "Iterate over the visible lines => lineNumber:\n    ask editor for line at lineNumber => lineUTF8;\n    layout lineUTF8 => lineGlyphQuads;\n\nlayout lineUTF8:\n    ask fontManager for a line's GlyphInfo => glyphInfo;\n    iterate over all the glyphs & layout them => lineGlyphQuads\n",
      "fontSize": 23.57170487077802,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "_dwykvQwh2MD8y-GEQP_w",
      "originalText": "Iterate over the visible lines => lineNumber:\n    ask editor for line at lineNumber => lineUTF8;\n    layout lineUTF8 => lineGlyphQuads;\n\nlayout lineUTF8:\n    ask fontManager for a line's GlyphInfo => glyphInfo;\n    iterate over all the glyphs & layout them => lineGlyphQuads\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
