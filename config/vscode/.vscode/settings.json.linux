{
   "keyboard.dispatch": "keyCode",
   "window.titleBarStyle": "custom",
   "vim.easymotion": true,
   "vim.incsearch": true,
   "vim.useSystemClipboard": true,
   "vim.useCtrlKeys": true,
   "vim.hlsearch": true,
   "vim.leader": "<space>",
   "vim.normalModeKeyBindings": [
      {
         "before": [
            "leader",
            "w"
         ],
         "commands": [
            "workbench.action.files.save"
         ]
      }
   ],
   "editor.fontFamily": "'JetBrains Mono', 'Lilex Nerd Font', monospace",
   "editor.fontSize": 13,
   "editor.fontLigatures": true,
   "editor.lineHeight": 1.5,
   "editor.codeLensFontFamily": "'JetBrains Mono', monospace",
   "editor.inlayHints.fontFamily": "'JetBrains Mono', monospace",
   "editor.inlayHints.enabled": "off",
   "editor.cursorBlinking": "solid",
   "editor.renderLineHighlight": "none",
   "editor.occurrencesHighlight": "off",
   "editor.guides.bracketPairs": "off",
   "editor.guides.bracketPairsHorizontal": false,
   "editor.parameterHints.enabled": true,
   "editor.inlineSuggest.enabled": true,
   "editor.minimap.enabled": false,
   "editor.rulers": [
      120
   ],
   "editor.formatOnSave": true,
   "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'Lilex Nerd Font', monospace",
   "terminal.integrated.fontSize": 13,
   "terminal.integrated.cwd": "${workspaceFolder}",
   "workbench.colorTheme": "Solarized Monochrome Dark",
   "workbench.iconTheme": "vscode-great-icons",
   "workbench.tree.indent": 16,
   "workbench.editor.wrapTabs": true,
   "workbench.editor.highlightModifiedTabs": true,
   "workbench.editorAssociations": {
      "*.glb": "modelViewer.gltfPreview"
   },
   "workbench.startupEditor": "none",
   "workbench.sideBar.location": "left",
   "workbench.secondarySideBar.defaultVisibility": "hidden",
   "explorer.autoReveal": false,
   "explorer.confirmDelete": false,
   "explorer.confirmDragAndDrop": false,
   "explorer.compactFolders": false,
   "chat.disableAIFeatures": true,
   "debug.terminal.clearBeforeReusing": true,
   "debug.openExplorerOnEnd": true,
   "debug.inlineValues": "on",
   "git.enableCommitSigning": false,
   "git.autofetch": true,
   "git.confirmSync": false,
   "git.detectSubmodules": true,
   "git.detectSubmodulesLimit": 30,
   "git.autoRepositoryDetection": true,
   "git.alwaysShowStagedChangesResourceGroup": true,
   "git.showProgress": true,
   "git.enableStatusBarSync": true,
   "git.openRepositoryInParentFolders": "never",
   "git-graph.repository.commits.showSignatureStatus": true,
   "[c]": {
      "editor.defaultFormatter": "xaver.clang-format"
   },
   "[cpp]": {
      "editor.defaultFormatter": "xaver.clang-format"
   },
   "[glsl]": {
      "editor.defaultFormatter": "xaver.clang-format"
   },
   "clangd.arguments": [
      "-header-insertion=never"
   ],
   "C_Cpp.intelliSenseEngine": "disabled",
   "C_Cpp.enhancedColorization": "disabled",
   "cmake.generator": "Ninja",
   "cmake.configureOnOpen": false,
   "cmake.configureOnEdit": false,
   "cmake.automaticReconfigure": true,
   "cmake.autoSelectActiveFolder": true,
   "cmake.buildBeforeRun": true,
   "cmake.setBuildTypeOnMultiConfig": true,
   "cmake.skipConfigureIfCachePresent": true,
   "cmake.buildDirectory": "${workspaceFolder}/build/${buildType}",
   "cmake.mergedCompileCommands": "${workspaceFolder}/build/compile_commands.json",
   "cmake.debugConfig": {
      "type": "cppdbg",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
         {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
         }
      ]
   },
   "cmake.options.statusBarVisibility": "visible",
   "cmake.options.advanced": {
      "cpack": {
         "statusBarVisibility": "hidden"
      },
      "workflow": {
         "statusBarVisibility": "hidden"
      },
      "variant": {
         "statusBarVisibility": "compact"
      }
   },
   "cmake.pinnedCommands": [
      "workbench.action.tasks.runTask",
      "workbench.action.tasks.configureTaskRunner"
   ],
   "cmake.showConfigureWithDebuggerNotification": false,
   "lldb.suppressUpdateNotifications": true,
   "yaml.format.singleQuote": true,
   "findJump.positionAbsolute": false,
   "findJump.dimWhenActive": true,
   "findJump.excludeNextChars": 1,
   "findJump.jumpChars": "123456789abcdefghijklmnopqrstuvwxyz",
   "excalidraw.theme": "auto",
   "extensions.ignoreRecommendations": false,
   "clangd.path": "/usr/bin/clangd",
   "clang-format.executable": "/usr/bin/clang-format"
}